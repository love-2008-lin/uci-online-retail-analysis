{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "Online Retail | October 2011",
  "dataColors": [
    "#2F80ED",
    "#16A6A1",
    "#5A728F",
    "#477A88",
    "#9AB0C7",
    "#526383"
  ],
  "background": "#FFFFFF",
  "foreground": "#25364A",
  "foregroundNeutralSecondary": "#53647A",
  "foregroundNeutralTertiary": "#778399",
  "accent": "#F2A541",
  "tableAccent": "#2F80ED",
  "secondaryBackground": "#F5F7FA",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 34,
      "color": "#25364A"
    },
    "largeTitle": {
      "fontFace": "Segoe UI",
      "fontSize": 18,
      "color": "#25364A"
    },
    "title": {
      "fontFace": "Segoe UI",
      "fontSize": 15,
      "color": "#25364A"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 13,
      "color": "#25364A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 13,
      "color": "#53647A"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE4ED"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 16,
            "fontColor": {
              "solid": {
                "color": "#25364A"
              }
            },
            "bold": true,
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "padding": [
          {
            "left": 18,
            "right": 18,
            "top": 13,
            "bottom": 12
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "$id": "default",
            "orientation": 2,
            "maxTiles": 4,
            "cellPadding": 24,
            "calloutSize": 58,
            "backgroundShow": false
          }
        ],
        "fillCustom": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "shapeCustomRectangle": [
          {
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 10
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#DCE4ED"
              }
            },
            "weight": 1,
            "transparency": 0
          }
        ],
        "label": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI",
            "fontSize": 14,
            "fontColor": {
              "solid": {
                "color": "#53647A"
              }
            },
            "position": "aboveValue",
            "matchValueAlignment": true
          }
        ],
        "value": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI",
            "fontSize": 34,
            "fontColor": {
              "solid": {
                "color": "#25364A"
              }
            },
            "bold": true,
            "horizontalAlignment": "left",
            "transparency": 0
          }
        ]
      }
    },
    "lineStackedColumnComboChart": {
      "*": {
        "categoryAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "labelColor": {
              "solid": {
                "color": "#53647A"
              }
            },
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "labelColor": {
              "solid": {
                "color": "#53647A"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5EBF2"
              }
            },
            "titleFontFamily": "Segoe UI",
            "titleFontSize": 13,
            "titleColor": {
              "solid": {
                "color": "#25364A"
              }
            },
            "showAxisTitle": true,
            "titleText": "正向商品金额（GBP）",
            "labelDisplayUnits": 1000,
            "labelPrecision": 0,
            "secShow": true,
            "secShowAxisTitle": true,
            "secTitleText": "有效发票数（张）",
            "secFontFamily": "Segoe UI",
            "secFontSize": 13,
            "secLabelColor": {
              "solid": {
                "color": "#53647A"
              }
            },
            "secLabelDisplayUnits": 1,
            "secLabelPrecision": 0,
            "secTitleFontFamily": "Segoe UI",
            "secTitleFontSize": 13,
            "secTitleColor": {
              "solid": {
                "color": "#25364A"
              }
            }
          }
        ],
        "legend": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "show": true,
            "showTitle": false,
            "position": "TopRight",
            "labelColor": {
              "solid": {
                "color": "#53647A"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "seriesLabels": [
          {
            "show": false
          }
        ],
        "lineStyles": [
          {
            "lineChartType": "linear",
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "labelColor": {
              "solid": {
                "color": "#53647A"
              }
            },
            "gridlineShow": false,
            "showAxisTitle": false,
            "innerPadding": 35
          }
        ],
        "valueAxis": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "labelColor": {
              "solid": {
                "color": "#53647A"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5EBF2"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 13,
            "show": true,
            "color": {
              "solid": {
                "color": "#25364A"
              }
            },
            "labelPosition": "OutsideEnd",
            "optimizeLabelDisplay": true
          }
        ]
      },
      "市场金额 · GBP": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#2F80ED"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true,
            "titleFontFamily": "Segoe UI",
            "titleFontSize": 13,
            "titleColor": {
              "solid": {
                "color": "#25364A"
              }
            },
            "titleText": "正向商品金额（GBP）",
            "labelDisplayUnits": 1000,
            "labelPrecision": 0
          }
        ],
        "labels": [
          {
            "labelDisplayUnits": 0,
            "labelPrecision": 1
          }
        ]
      },
      "市场发票数 · 张": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#16A6A1"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true,
            "titleFontFamily": "Segoe UI",
            "titleFontSize": 13,
            "titleColor": {
              "solid": {
                "color": "#25364A"
              }
            },
            "titleText": "有效发票数（张）",
            "labelDisplayUnits": 1,
            "labelPrecision": 0
          }
        ],
        "labels": [
          {
            "labelDisplayUnits": 0,
            "labelPrecision": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "right": 0,
            "bottom": 0,
            "left": 0
          }
        ]
      }
    }
  }
}