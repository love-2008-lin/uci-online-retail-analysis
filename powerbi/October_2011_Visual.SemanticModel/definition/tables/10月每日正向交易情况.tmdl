	partition 10月每日正向交易情况 = m
		mode: import
		source =
				let
				    源 = MySQL.Database("localhost:3306", "data_10month", [ReturnSingleDatabase=true, Query="# 创建日期表#(lf)WITH RECURSIVE date_series AS(#(lf)#(tab)SELECT DATE('2011-10-01') AS sale_day#(lf)#(tab)UNION ALL#(lf)#(tab)SELECT DATE_ADD(sale_day,INTERVAL 1 DAY)#(lf)#(tab)FROM date_series #(lf)#(tab)WHERE sale_day < DATE('2011-10-31')#(lf))#(lf)#(lf)# 查询每日正向商品金额#(lf)SELECT #(lf)#(tab)dt.sale_day ,#(lf)#(tab)IFNULL(d.gross_amount_gbp,0) AS gross_amount_gbp ,#(lf)#(tab)IFNULL(d.invoice_count,0) AS invoice_count#(lf)FROM date_series dt#(lf)LEFT JOIN (#(lf)#(tab)SELECT #(lf)#(tab)#(tab)DATE(invoicedate) AS sale_day ,#(lf)#(tab)#(tab)SUM(lineamount) AS gross_amount_gbp ,#(lf)#(tab)#(tab)COUNT(DISTINCT(invoiceno)) AS invoice_count#(lf)#(tab)FROM lavel2#(lf)#(tab)GROUP BY DATE(invoicedate)#(lf)) AS d#(lf)ON dt.sale_day = d.sale_day#(lf)ORDER BY dt.sale_day ASC;#(lf)"]),
				    重命名的列 = Table.RenameColumns(源,{{"gross_amount_gbp", "正向商品金额"}, {"invoice_count", "有效发票数"}, {"sale_day", "日期"}})
				in
				    重命名的列

	annotation PBI_ResultType = Table

