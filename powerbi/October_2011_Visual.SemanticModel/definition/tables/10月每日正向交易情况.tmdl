	measure 每张发票平均金额 = DIVIDE( sum('10月每日正向交易情况'[正向商品金额]) ,sum('10月每日正向交易情况'[有效发票数]),0 )
		lineageTag: a056ffd8-abe8-4988-9f1f-fdf4adf12608

